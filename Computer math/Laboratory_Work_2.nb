Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["x", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
      RowBox[{
       SuperscriptBox["t", "2"], "+", 
       RowBox[{"y", "[", "t", "]"}]}]}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox["y", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
      RowBox[{"x", "[", "t", "]"}]}]}], "}"}], ",", 
   RowBox[{"y", "[", "t", "]"}], ",", 
   RowBox[{"x", "[", "t", "]"}]}], "]"}]], "Output",
 CellChangeTimes->{3.998309002661293*^9},
